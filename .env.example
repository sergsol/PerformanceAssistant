# Required
SECRET_KEY=change-me-in-production-minimum-32-chars

# LLM provider: gemini | groq | stub
# stub = no API call, returns deterministic fake assessments (used in tests)
LLM_PROVIDER=stub

# Gemini (primary, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (alternative, free tier, fast)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Database: SQLite by default. Set to Postgres connection string in production.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Server
PORT=8000

# Frontend (Vite dev server URL; used for CORS + API base)
# VITE_API_URL=http://localhost:8000
